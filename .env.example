# Nusxa oling:  cp .env.example .env   va qiymatlarni o'zgartiring.
# Bu fayl ham PyCharm'dagi runserver, ham docker compose uchun ishlaydi.

# Serverga chiqarishda: DJANGO_DEBUG=False va kuchli DJANGO_SECRET_KEY qo'ying
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL
POSTGRES_DB=toy_qachon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# PyCharm'dan ishga tushirganda Docker'dagi bazaga shu orqali ulanadi.
# Docker ichida esa docker-compose.yml bularni database:5432 ga almashtiradi.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Ixtiyoriy: admin avtomatik yaratilsin desangiz
DJANGO_SUPERUSER_PHONE_NUMBER=
DJANGO_SUPERUSER_PASSWORD=
