/div>\n      <button class=\"btn btn-gold\" id=\"addBudgetBtn\">+ Kategoriya qo'shish</button>\n    </div>\n\n    <section class=\"grid g-4\">\n      <div class=\"card stat\"><div class=\"stat-icon\">\uD83C\uDFAF</div><div class=\"stat-value\" id=\"budgetTotal\">0</div><div class=\"stat-label\">Umumiy byudjet</div></div>\n      <div class=\"card stat\"><div class=\"stat-icon\">\uD83D\uDCB8</div><div class=\"stat-value\" id=\"budgetSpent\">0</div><div class=\"stat-label\">Sarflangan</div></div>\n      <div class=\"card stat\"><div class=\"stat-icon\">\uD83C\uDFE6</div><div class=\"stat-value\" id=\"budgetLeft\">0</div><div class=\"stat-label\">Qolgan mablag'</div></div>\n      <div class=\"card stat\"><div class=\"stat-icon\">\uD83D\uDCCA</div><div class=\"stat-value\" id=\"budgetPct\">0%</div><div class=\"stat-label\">Umumiy sarf</div></div>\n    </section>\n\n    <section class=\"grid g-2 mt\">\n      <div class=\"card\">\n        <div class=\"card-head\"><h2>Kategoriyalar</h2></div>\n        <div id=\"categoryList\"></div>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"card-head\"><h2>Taqsimot</h2></div>\n        <ul id=\"distribution\" style=\"list-style:none; display:flex; flex-direction:column; gap:12px;\"></ul>\n      </div>\n    </section>\n\n    <section class=\"card mt\">\n      <div class=\"card-head\"><h2>Xarajatlar jadvali</h2></div>\n      <div class=\"table-wrap\">\n        <table>\n          <thead>\n            <tr>\n              <th>Kategoriya</th><th>Rejalashtirilgan</th><th>Sarflangan</th><th>Qolgan</th><th>Izoh</th><th></th>\n            </tr>\n          </thead>\n          <tbody id=\"budgetRows\"></tbody>\n        </table>\n        <div class=\"empty\" id=\"budgetEmpty\" style=\"display:none\">Hali kategoriya qo'shilmagan</div>\n      </div>\n    </section>\n  </main>\n</div>\n\n<!-- Qo'shish / tahrirlash modali -->\n<div class=\"modal\" id=\"budgetModal\">\n  <form class=\"modal-box\" id=\"budgetForm\">\n    <h3 id=\"budgetModalTitle\">Yangi kategoriya</h3>\n    <div class=\"form-grid\">\n      <label class=\"full\">Kategoriya nomi\n        <input class=\"input\" name=\"category\" required>\n      </label>\n      <label>Rejalashtirilgan summa\n        <input class=\"input\" name=\"planned_amount\" type=\"number\" min=\"0\" required>\n      </label>\n      <label>Sarflangan summa\n        <input class=\"input\" name=\"spent_amount\" type=\"number\" min=\"0\" required>\n      </label>\n      <label class=\"full\">Izoh\n        <input class=\"input\" name=\"note\">\n      </label>\n    </div>\n    <p class=\"auth-error\" id=\"budgetError\"></p>\n    <div class=\"modal-actions\">\n      <button type=\"button\" class=\"btn\" id=\"cancelBudgetBtn\">Bekor qilish</button>\n      <button type=\"submit\" class=\"btn btn-gold\">Saqlash</button>\n    </div>\n  </form>\n</div>\n\n<div class=\"toast-wrap\" id=\"toastWrap\"></div>\n\n<script src=\"{% static 'apps/style.js' %}\"></script>\n<script src=\"{% static 'apps/auth.js' %}\"></script>\n<script src=\"{% static 'apps/budget.js' %}\"></script>\n</body>\n</html>
